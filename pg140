    for (i = 2; i < ip; i++)
    {
        if (ip % i == 0)
        {
            flag = 1;
            break;
        }
    }
    while(ip>0)
    {
        b=ip%10;
        sum=sum+b;
        ip=ip/10;
    }
    //printf("%d\n",sum);
    x=ip;
    if (flag == 0 && sum==14)
        printf(" prime number and sum=14");
