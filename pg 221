#include <stdio.h>
#include <stdlib.h>

struct student
{
    int id;
    int maths;
    int science;
    struct student *prev;
    struct student *next;
};

/* Create a new node */
struct student* create_node(int id, int maths, int science)
{
    struct student *newnode;

    newnode = (struct student*)malloc(sizeof(struct student));

    newnode->id = id;
    newnode->maths = maths;
    newnode->science = science;
    newnode->prev = NULL;
    newnode->next = NULL;

    return newnode;
}

/* Display the list */
void display(struct student *head)
{
    struct student *temp = head;

    printf("\n--- Student List ---\n");

    while(temp != NULL)
    {
        printf("ID: %d  Maths: %d  Science: %d\n",
               temp->id, temp->maths, temp->science);

        temp = temp->next;
    }
}

/* Insert before a given ID */
void insert_before(struct student **head, int given_id,
                   int id, int maths, int science)
{
    struct student *temp = *head;
    struct student *newnode;

    while(temp != NULL)
    {
        if(temp->id == given_id)
        {
            newnode = create_node(id, maths, science);

            newnode->next = temp;
            newnode->prev = temp->prev;

            if(temp->prev != NULL)
                temp->prev->next = newnode;
            else
                *head = newnode;

            temp->prev = newnode;

            printf("Entry inserted successfully.\n");
            return;
        }

        temp = temp->next;
    }

    printf("ID %d not found.\n", given_id);
}

/* Insert after a given ID */
void insert_after(struct student *head, int given_id,
                  int id, int maths, int science)
{
    struct student *temp = head;
    struct student *newnode;

    while(temp != NULL)
    {
        if(temp->id == given_id)
        {
            newnode = create_node(id, maths, science);

            newnode->prev = temp;
            newnode->next = temp->next;

            if(temp->next != NULL)
                temp->next->prev = newnode;

            temp->next = newnode;

            printf("Entry inserted successfully.\n");
            return;
        }

        temp = temp->next;
    }

    printf("ID %d not found.\n", given_id);
}

/* Delete an entry */
void delete_entry(struct student **head, int given_id)
{
    struct student *temp = *head;

    while(temp != NULL)
    {
        if(temp->id == given_id)
        {
            if(temp->prev != NULL)
                temp->prev->next = temp->next;
            else
                *head = temp->next;

            if(temp->next != NULL)
                temp->next->prev = temp->prev;

            free(temp);

            printf("Entry deleted successfully.\n");
            return;
        }

        temp = temp->next;
    }

    printf("ID %d not found.\n", given_id);
}

int main()
{
    struct student *head;
    struct student *temp;

    int choice;
    int position;
    int given_id;
    int id, maths, science;

    /* Create sample doubly linked list with 5 entries */

    head = create_node(101, 85, 90);

    head->next = create_node(102, 78, 88);
    head->next->prev = head;

    head->next->next = create_node(103, 92, 95);
    head->next->next->prev = head->next;

    head->next->next->next = create_node(104, 75, 80);
    head->next->next->next->prev = head->next->next;

    head->next->next->next->next = create_node(105, 89, 91);
    head->next->next->next->next->prev =
        head->next->next->next;

    while(1)
    {
        printf("\n===== MENU =====\n");
        printf("1. Insert Entry\n");
        printf("2. Delete Entry\n");
        printf("3. Display List\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:

                printf("\nEnter new ID: ");
                scanf("%d", &id);

                printf("Enter Maths mark: ");
                scanf("%d", &maths);

                printf("Enter Science mark: ");
                scanf("%d", &science);

                printf("Enter the ID before/after which to insert: ");
                scanf("%d", &given_id);

                printf("\n1. Insert Before\n");
                printf("2. Insert After\n");
                printf("Enter your choice: ");
                scanf("%d", &position);

                if(position == 1)
                {
                    insert_before(&head, given_id,
                                  id, maths, science);
                }
                else if(position == 2)
                {
                    insert_after(head, given_id,
                                 id, maths, science);
                }
                else
                {
                    printf("Invalid choice.\n");
                }

                break;

            case 2:

                printf("\nEnter ID to delete: ");
                scanf("%d", &given_id);

                delete_entry(&head, given_id);

                break;

            case 3:

                display(head);

                break;

            case 4:

                printf("Exiting program...\n");

                temp = head;

                while(temp != NULL)
                {
                    struct student *next = temp->next;
                    free(temp);
                    temp = next;
                }

                return 0;

            default:

                printf("Invalid choice.\n");
        }
    }

    return 0;
}
