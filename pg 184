#include <stdio.h>

int main()
{
    int a[5], b[5];
    int i, j, k, prime;

    printf("Enter 5 numbers:\n");

    for(i = 0; i < 5; i++)
    {
        scanf("%d", &a[i]);
    }

    k = 0;

    for(i = 0; i < 5; i++)
    {
        prime = 1;

        if(a[i] < 2)
        {
            prime = 0;
        }
        else
        {
            for(j = 2; j < a[i]; j++)
            {
                if(a[i] % j == 0)
                {
                    prime = 0;
                    break;
                }
            }
        }

        // Store only non-prime numbers
        if(prime == 0)
        {
            b[k] = a[i];
            k++;
        }
    }

    printf("Array after removing prime numbers:\n");

    for(i = 0; i < k; i++)
    {
        printf("%d ", b[i]);
    }

    return 0;
}


