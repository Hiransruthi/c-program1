// Online C compiler to run C program online
#include <stdio.h>
#include <math.h>

int main() {
    int x,a=0,c=0,ip,i,b,d;
    printf("enter the number:");
    scanf("%d",&ip);
    x=ip;
    while(x>0)
    {
        x=x/10;
        c=c+1;
    }
    printf("%d\n",c);
   x=ip;
   a=(x%10)*pow(10,(c-1));//unit
   b=x/pow(10,(c-1));//middle
   d=(x%(int)pow(10,(c-1)))-(x%10);//first
   printf("the req number is : %d",a+b+d);
    return 0;
}
