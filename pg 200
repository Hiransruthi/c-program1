#include <stdio.h>

int main()
{
    char num[51];
    int i, length = 0;

    printf("Enter a number (up to 50 digits): ");
    scanf("%50s", num);

    // Find the length
    while (num[length] != '\0')
    {
        length++;
    }

    // Print in reverse order
    printf("Reversed number: ");

    for (i = length - 1; i >= 0; i--)
    {
        printf("%c", num[i]);
    }

    return 0;
}
