#include <stdio.h>

void arrange_ascend(int arr[], int n)
{
    int i, j, temp;

    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(arr[i] > arr[j])
            {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }
}

int main()
{
    int arr[5] = {5, 4, 3, 2, 1};
    int i;

    arrange_ascend(arr, 5);

    printf("Ascending order:\n");

    for(i = 0; i < 5; i++)
    {
        printf("%d\n", arr[i]);
    }

    return 0;
}
