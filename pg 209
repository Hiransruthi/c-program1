#include <stdio.h>

int memcomp(int src[], int dst[], int size)
{
    int i;

    for(i = 0; i < size; i++)
    {
        if(src[i] != dst[i])
        {
            return 0;   // Failure
        }
    }

    return 1;           // Success
}

int main()
{
    int src[5] = {10, 20, 30, 40, 50};
    int dst[5] = {10, 20, 30, 40, 50};

    if(memcomp(src, dst, 5))
    {
        printf("Success\n");
    }
    else
    {
        printf("Failure\n");
    }

    return 0;
}
