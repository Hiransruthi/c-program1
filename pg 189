#include <stdio.h>
#include <string.h>

int main()
{
    int a[50], b[50], c[51];
    int i, j, k, carry = 0;
    char n1[51], n2[51];
    int len1, len2, max;

    printf("Enter first number (up to 50 digits): ");
    scanf("%50s", n1);

    printf("Enter second number (up to 50 digits): ");
    scanf("%50s", n2);

    len1 = strlen(n1);
    len2 = strlen(n2);

    /* Convert characters into integer digits */
    for(i = 0; i < len1; i++)
    {
        a[i] = n1[i] - '0';
    }

    for(i = 0; i < len2; i++)
    {
        b[i] = n2[i] - '0';
    }

    i = len1 - 1;
    j = len2 - 1;
    k = 50;

    /* Add from right to left */
    while(i >= 0 || j >= 0 || carry != 0)
    {
        int sum = carry;

        if(i >= 0)
        {
            sum = sum + a[i];
            i--;
        }

        if(j >= 0)
        {
            sum = sum + b[j];
            j--;
        }

        c[k] = sum % 10;
        carry = sum / 10;
        k--;
    }

    printf("Sum = ");

    for(i = k + 1; i <= 50; i++)
    {
        printf("%d", c[i]);
    }

    return 0;
}

