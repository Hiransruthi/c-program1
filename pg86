#include<stdio.h>
int main() {
    int x,c=0,ip,count=0,i,a;
    printf("enter the num: ");
    scanf("%d",&ip);
    x=ip;
    while(x>0)
    {
        x=x/10;
        c=c+1;
    }
    //printf("count :%d\n",c);
    x=ip;
    for(i=1;i<=c;i++)
    {
        a=x%10;
        {
            if(a%2!=0)
            count++;
        }
        x=x/10;
    }
    printf("%d odd numbers are present \n",count);
    return 0;
}
