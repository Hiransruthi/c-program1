#include <stdio.h>

void strcon(char src1[], char src2[], char dst[])
{
    int i = 0;
    int j = 0;

    // Copy first string
    while(src1[i] != '\0')
    {
        dst[i] = src1[i];
        i++;
    }

    // Copy second string
    while(src2[j] != '\0')
    {
        dst[i] = src2[j];
        i++;
        j++;
    }

    // Add null character
    dst[i] = '\0';
}

int main()
{
    char src1[50] = "Hello ";
    char src2[50] = "World";
    char dst[100];

    strcon(src1, src2, dst);

    printf("Concatenated string: %s\n", dst);

    return 0;
}
