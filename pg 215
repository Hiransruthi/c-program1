#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    char sub[50];
    int i, j, found;

    printf("Enter main string: ");
    scanf("%s", str);

    printf("Enter substring: ");
    scanf("%s", sub);

    found = 0;

    for(i = 0; str[i] != '\0'; i++)
    {
        j = 0;

        while(sub[j] != '\0' && str[i + j] == sub[j])
        {
            j++;
        }

        if(sub[j] == '\0')
        {
            printf("Substring found at position: %d\n", i);
            found = 1;
            break;
        }
    }

    if(found == 0)
    {
        printf("Substring not found\n");
    }

    return 0;
}
