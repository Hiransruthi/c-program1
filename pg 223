#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *next;
};

struct node *top = NULL;

/* Add operation */
void add()
{
    struct node *newnode;
    int value;

    newnode = (struct node *)malloc(sizeof(struct node));

    printf("Enter value: ");
    scanf("%d", &value);

    newnode->data = value;
    newnode->next = top;
    top = newnode;

    printf("Element added successfully.\n");
}

/* Remove operation */
void remove_element()
{
    struct node *temp;
    struct node *prev;

    if(top == NULL)
    {
        printf("Queue is empty.\n");
        return;
    }

    /* If only one element is present */
    if(top->next == NULL)
    {
        printf("Removed element: %d\n", top->data);
        free(top);
        top = NULL;
        return;
    }

    temp = top;
    prev = NULL;

    /* Find the bottom node */
    while(temp->next != NULL)
    {
        prev = temp;
        temp = temp->next;
    }

    printf("Removed element: %d\n", temp->data);

    prev->next = NULL;
    free(temp);
}

/* Display operation */
void display()
{
    struct node *temp;

    if(top == NULL)
    {
        printf("Queue is empty.\n");
        return;
    }

    temp = top;

    printf("Queue (Top to Bottom):\n");

    while(temp != NULL)
    {
        printf("%d\n", temp->data);
        temp = temp->next;
    }
}

int main()
{
    int choice;

    while(1)
    {
        printf("\n===== QUEUE MENU =====\n");
        printf("1. Add\n");
        printf("2. Remove\n");
        printf("3. Display Stack\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                add();
                break;

            case 2:
                remove_element();
                break;

            case 3:
                display();
                break;

            case 4:
                printf("Exiting...\n");
                return 0;

            default:
                printf("Invalid choice.\n");
        }
    }

    return 0;
}
