#include <stdio.h>

int main()
{
    int a[100];
    int i = 0, num;
    float average;

    printf("Enter numbers (enter 0 to stop):\n");

    while(1)
    {
        scanf("%d", &num);

        if(num == 0)
        {
            break;
        }

        a[i] = num;
        i++;
    }

    if(i % 2 != 0)
    {
        // Odd number of elements
        printf("Middle number = %d", a[i / 2]);
    }
    else
    {
        // Even number of elements
        average = (a[(i / 2) - 1] + a[i / 2]) / 2.0;

        printf("Average of middle two numbers = %.2f", average);
    }

    return 0;
}

