#include <stdio.h>

int main()
{
    int arr[50];
    char str[51];
    int n, i;

    printf("Enter the number of digits: ");
    scanf("%d", &n);

    printf("Enter %d digits:\n", n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    // Convert integer array to character array
    for(i = 0; i < n; i++)
    {
        str[i] = arr[i] + '0';
    }

    // Add null character at the end
    str[n] = '\0';

    printf("Character array: %s\n", str);

    return 0;
}
