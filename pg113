#include <stdio.h>

int main()
{
    int n = 2, i, flag, count = 0;

    while(n < 10)
    {
        flag = 1;
        i = 2;

        while(i < n)
        {
            if(n % i == 0)
            {
                flag = 0;
                break;
            }
            i++;
        }

        if(flag == 1)
        {
            count++;
        }

        n++;
    }

    printf("Count = %d", count);

    return 0;
}
