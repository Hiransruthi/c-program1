#include <stdio.h>

int main()
{
    char str[100];
    char ch;
    int i;

    printf("Enter a string: ");
    scanf("%s", str);

    printf("Enter a character: ");
    scanf(" %c", &ch);

    printf("Character '%c' is present at positions: ", ch);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] == ch)
        {
            printf("%d ", i);
        }
    }

    return 0;
}
