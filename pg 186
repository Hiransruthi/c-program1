#include <stdio.h>

int main()
{
    int a[100];
    int i = 0, num, sum = 0;

    printf("Enter numbers (enter 0 to stop):\n");

    while(1)
    {
        scanf("%d", &num);

        if(num == 0)
        {
            break;
        }

        a[i] = num;
        sum = sum + a[i];
        i++;
    }

    printf("Total numbers entered = %d\n", i);
    printf("Sum of the numbers = %d\n", sum);

    return 0;
}

