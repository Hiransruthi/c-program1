#include <stdio.h>

int main()
{
    int a[100];
    int i = 0, num;

    printf("Enter numbers (enter 0 to stop):\n");

    while(1)
    {
        scanf("%d", &num);

        if(num == 0)
        {
            break;
        }

        a[i] = num;
        i++;
    }

    if(i == 4)
    {
        if(a[0] == a[3])
        {
            printf("SUCCESS");
        }
        else
        {
            printf("FAILURE");
        }
    }
    else
    {
        printf("FAILURE");
    }

    return 0;
}

