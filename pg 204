#include <stdio.h>

void increment(int arr[], int n)
{
    int i;

    for(i = 0; i < n; i++)
    {
        arr[i] = arr[i] + 1;
    }
}

int main()
{
    int arr[5] = {10, 20, 30, 40, 50};
    int i;

    printf("Before increment:\n");
    for(i = 0; i < 5; i++)
    {
        printf("%d ", arr[i]);
    }

    increment(arr, 5);

    printf("\n\nAfter increment:\n");
    for(i = 0; i < 5; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
