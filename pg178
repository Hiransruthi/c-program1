// Online C compiler to run C program online
#include <stdio.h>

int main() {
    int i,a[5],small;
    printf("enter five numbers: ");
    for(i=0;i<5;i++)
    {
        scanf("%d",&a[i]);
    }
    small=a[0];
    for(i=1;i<5;i++)
    {
        if(a[i]<small)
        {
            small=a[i];
        }
    }
    printf("the smallest number is : %d",small);
    return 0;
}
