#include <stdio.h>
#include <string.h>

int main()
{
    char num1[51], num2[51];
    int result[101] = {0};
    int len1, len2;
    int i, j, k;
    int digit1, digit2, sum;

    printf("Enter first number: ");
    scanf("%50s", num1);

    printf("Enter second number: ");
    scanf("%50s", num2);

    len1 = strlen(num1);
    len2 = strlen(num2);

    /* Multiplication */
    for(i = len1 - 1; i >= 0; i--)
    {
        digit1 = num1[i] - '0';

        for(j = len2 - 1; j >= 0; j--)
        {
            digit2 = num2[j] - '0';

            result[i + j + 1] += digit1 * digit2;
        }
    }

    /* Handle carry */
    for(k = len1 + len2 - 1; k > 0; k--)
    {
        result[k - 1] += result[k] / 10;
        result[k] = result[k] % 10;
    }

    /* Print result */
    printf("Result = ");

    i = 0;

    /* Skip leading zeros */
    while(i < len1 + len2 - 1 && result[i] == 0)
    {
        i++;
    }

    for(; i < len1 + len2; i++)
    {
        printf("%d", result[i]);
    }

    printf("\n");

    return 0;
}
