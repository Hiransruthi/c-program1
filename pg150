#include <stdio.h>

int disp_count_sum14();

int main()
{
    disp_count_sum14();
    return 0;
}

int disp_count_sum14()
{
    int i,b,sum,c,e=0;
    for(i=1;i<=100000;i++)
    {
        b=i;
        sum=0;
        while(b>0)
        {
            c=b%10;
            sum=sum+c;
            b=b/10;
        }
        if(sum==14)
        {
            e=e+1;
        }
    }
    printf("count= %d",e);
   
   return 0;
}
