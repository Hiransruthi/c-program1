#include <stdio.h>

int main()
{
    int n, i, flag = 1,a,sum=0,ip;

    printf("Enter a number: ");
    scanf("%d", &ip);
    n=ip%100;

    if (n <= 1)
    {
        flag = 0;
    }
    else
    {
        for (i = 2; i < n; i++)
        {
            if (n % i == 0)
            {
                flag = 0;
                break;
            }
        }
    }
    if (flag == 1)
        printf(" Prime Number");
    else
       printf("not a prime number");

    return 0;
}
