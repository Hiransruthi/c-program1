#include <stdio.h>

void intcon(int src1[], int size1, int src2[], int size2, int dst[])
{
    int i;

    // Copy first array
    for(i = 0; i < size1; i++)
    {
        dst[i] = src1[i];
    }

    // Copy second array
    for(i = 0; i < size2; i++)
    {
        dst[size1 + i] = src2[i];
    }
}

int main()
{
    int src1[3] = {10, 20, 30};
    int src2[3] = {40, 50, 60};
    int dst[6];
    int i;

    intcon(src1, 3, src2, 3, dst);

    printf("Concatenated array:\n");

    for(i = 0; i < 6; i++)
    {
        printf("%d ", dst[i]);
    }

    return 0;
}
