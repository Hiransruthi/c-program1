int check_prime()
{
    int i, flag = 0,ip;
    printf("enter the number");
    scanf("%d",&ip);

    if (ip <= 1)
    {
        printf("%d is not a prime number", ip);
        return 0;
    }

    for (i = 2; i < ip; i++)
    {
        if (ip % i == 0)
        {
            flag = 1;
            break;
        }
    }

    if (flag == 0)
        printf("%d is a prime number", ip);
    else
        printf("%d is not a prime number", ip);

    return 0;
}
