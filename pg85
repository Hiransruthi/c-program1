#include<stdio.h>
int main() {
    int x,i,flag,count=0;
    for(x=2;x<10;x++)
    {
        flag=1;
        for(i=2;i<x;i++)
        {
            if(x%i==0)
            {
                flag=0;
                break;
            }
        }
    
    if(flag==1)
    {
       count++;
    }
    }
    printf("%d\n",count);
    return 0;
}
